# Example .env for Docker deployment with external (host) PostgreSQL 17.
# Copy to .env and set DATABASE_URL to match your local Postgres.

# Custom Caffine branch (build first: from repo root run .docker/selfhost/build-caffine-image.sh)
AFFINE_IMAGE=caffine:latest
# Or use upstream: leave AFFINE_IMAGE unset for ghcr.io/toeverything/affine:stable, or set e.g. AFFINE_IMAGE=ghcr.io/toeverything/affine:canary

PORT=3010

# Required: URL to your local Postgres 17. From inside Docker, use host.docker.internal to reach the host.
# Match the user/password/database you created with init-external-db.sql (user caffine, password caffine, database caffine).
DATABASE_URL=postgresql://caffine:caffine@host.docker.internal:5432/caffine

# Persist app data on host (not DB data; that stays in your Postgres).
UPLOAD_LOCATION=~/.affine/self-host/storage
CONFIG_LOCATION=~/.affine/self-host/config
